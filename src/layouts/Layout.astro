---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { routes, type Lang, type PageKey } from '../i18n/utils';
import { SITE_URL, SITE_NAME, PHONE, GEO, OPENING_HOURS, MENU_PDF_PATH, INSTAGRAM_URL, FACEBOOK_URL } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  image?: string;
  page?: PageKey;
}

const {
  lang = "es",
  page = "home",
} = Astro.props;

// Título de la pestaña: nombre corto + ubicación (ayuda al SEO local)
const defaultTitle = lang === 'en' ? "Wayko's Restaurant | La Esperanza, Ibarra" : "Wayko's Restaurante | La Esperanza, Ibarra";

const defaultDescription = lang === 'en'
  ? "Rural restaurant in La Esperanza, Ibarra, Ecuador. Lamb, grilled steaks and artisanal pizzas, cooked with local, seasonal produce."
  : "Restaurante rural en La Esperanza, Ibarra, Ecuador. Cordero, cortes al grill y pizzas artesanales, con productos locales y de temporada.";

const title = Astro.props.title || defaultTitle;
const description = Astro.props.description || defaultDescription;

const siteUrl = SITE_URL;
const canonicalUrl = `${siteUrl}${routes[page][lang]}`;
const ogImageUrl = Astro.props.image || `${siteUrl}/og-image.jpg`;

// Structured Data (JSON-LD) for Google Rich Snippets (Restaurant)
const restaurantSchema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "@id": `${siteUrl}/#restaurant`,
  "name": SITE_NAME,
  "alternateName": ["Waykos", "Wayko's", "Waykos Restaurante", "Waykos Ibarra"],
  "description": description,
  "url": siteUrl,
  "image": ogImageUrl,
  "telephone": PHONE,
  "priceRange": "$$",
  "servesCuisine": [
    "Parrillada",
    "Cordero Asado",
    "Borrego de Granja",
    "Cortes al Grill",
    "Pizzas Artesanales",
    "Cocina Tradicional Ecuatoriana"
  ],
  "hasMenu": `${siteUrl}${MENU_PDF_PATH}`,
  "acceptsReservations": true,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Vía Principal La Esperanza",
    "addressLocality": "La Esperanza, Ibarra",
    "addressRegion": "Imbabura",
    "postalCode": "100150",
    "addressCountry": "EC"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": GEO.lat,
    "longitude": GEO.lng
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": OPENING_HOURS.days,
      "opens": OPENING_HOURS.opens,
      "closes": OPENING_HOURS.closes
    }
  ],
  "sameAs": [INSTAGRAM_URL, FACEBOOK_URL]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Robots directives for Google Search & large image previews -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Multi-language Hreflang Tags -->
    <link rel="alternate" hreflang="es" href={`${siteUrl}${routes[page].es}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${routes[page].en}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${routes[page].es}`} />

    <!-- Open Graph (WhatsApp, Facebook, Social) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === 'en' ? "Wayko's Rural Restaurant - Farm lamb in La Esperanza, Ibarra, Ecuador" : "Wayko's Restaurante Rural - Cordero y Borrego en La Esperanza, Ibarra, Ecuador"} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_EC'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Schema.org JSON-LD Structured Data for Google Restaurant Rich Snippets -->
    <script type="application/ld+json" set:html={JSON.stringify(restaurantSchema)} />

    <!-- Fuentes alojadas en el propio sitio (Astro Fonts API) -->
    <Font cssVariable="--font-alegreya-sans" preload />
    <Font cssVariable="--font-alegreya" preload />

    <!--
      Tema antes de pintar (evita el parpadeo). Prioridad:
      1. Elección manual del visitante, válida por 12 horas.
      2. Modo oscuro del sistema.
      3. Horario: oscuro de 18:30 a 6:00, hora del dispositivo.
    -->
    <script is:inline>
      (function () {
        let manual = null;
        try {
          const saved = JSON.parse(localStorage.getItem('waykos-theme') || 'null');
          if (saved && Date.now() - saved.at < 12 * 60 * 60 * 1000) manual = saved.theme;
        } catch (e) {}
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const now = new Date();
        const minutes = now.getHours() * 60 + now.getMinutes();
        const night = minutes >= 18 * 60 + 30 || minutes < 6 * 60;
        const dark = manual ? manual === 'dark' : systemDark || night;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="selection:bg-poncho selection:text-white">
    <slot />
  </body>
</html>
