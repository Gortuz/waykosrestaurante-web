---
import { Image } from 'astro:assets';
import potrero from '../assets/fotos/granja-potrero.webp';
import borregoNegro from '../assets/fotos/granja-borrego-negro.webp';
import rebano from '../assets/fotos/granja-rebano.webp';
import corral from '../assets/fotos/granja-corral.webp';
import borregoBlanco from '../assets/fotos/granja-borrego-blanco.webp';
import gallo from '../assets/fotos/granja-gallo.webp';
import gallo2 from '../assets/fotos/granja-gallo-2.webp';
import { useTranslations, type Lang } from '../i18n/utils';
import { GOOGLE_MAPS_NAV_URL, WAZE_NAV_URL } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const en = lang === 'en';

// Borregos y gallinas mezclados: la granja se cuenta como un todo.
// El detalle de cada animal se muestra al pasar el cursor, enfocar o tocar la foto.
const sheep = t('farm.captionSheep');
const chicken = t('farm.captionChicken');
const photos = [
  { src: borregoNegro, caption: sheep, alt: en ? 'Black-faced sheep looking at the camera in the barn' : 'Borrego de cara negra mirando a la cámara en el establo' },
  { src: gallo, caption: chicken, alt: en ? 'Free-range rooster on the farm' : 'Gallo criado en libertad en la granja' },
  { src: rebano, caption: sheep, alt: en ? 'Flock of sheep in the barn with trees and mountains behind' : 'Rebaño en el establo con árboles y montañas al fondo' },
  { src: borregoBlanco, caption: sheep, alt: en ? 'White-faced sheep seen through the barn fence' : 'Borrego de cara blanca visto a través de la reja del establo' },
  { src: gallo2, caption: chicken, alt: en ? 'Rooster walking on straw outdoors' : 'Gallo caminando sobre la paja al aire libre' },
  { src: corral, caption: sheep, alt: en ? 'Sheep standing on straw inside the barn' : 'Borregos sobre la paja dentro del establo' },
];

const figureClass = 'farm-photo group relative overflow-hidden cursor-pointer';
const captionClass = 'absolute inset-x-0 bottom-0 bg-carbon/85 text-[#eee7df] text-sm sm:text-base px-4 py-3 opacity-0 translate-y-2 transition duration-200 group-hover:opacity-100 group-hover:translate-y-0 group-focus-visible:opacity-100 group-focus-visible:translate-y-0 group-[.is-open]:opacity-100 group-[.is-open]:translate-y-0';
---

<section class="bg-surface px-4 sm:px-8 pt-14 sm:pt-20 pb-16 sm:pb-24">
  <div class="max-w-7xl mx-auto">
    <!-- Logo de Wayko's con "Granja" debajo -->
    <div class="inline-flex flex-col items-start" aria-label={`Wayko's ${t('farm.label')}`} role="img">
      <img src="/waykos-horizontal.svg" alt="" width="1182" height="275" class="waykos-logo-svg h-12 sm:h-14 w-auto" />
      <span class="mt-1.5 self-stretch text-center font-sans font-bold text-accent-text text-sm sm:text-base tracking-[0.55em] pl-[0.55em] border-t-2 border-rule-accent pt-1.5" aria-hidden="true">
        {t('farm.label').toUpperCase()}
      </span>
    </div>

    <h1 class="mt-10 font-serif font-bold text-[clamp(2.75rem,6.5vw,5.5rem)] leading-[0.98] text-ink max-w-[14ch]">
      {t('farm.title')}
    </h1>

    <!-- Fotos de la granja -->
    <figure class:list={[figureClass, 'mt-12 sm:mt-16']} tabindex="0">
      <Image
        src={potrero}
        alt={en ? 'Pasture with eucalyptus trees and mountains in La Esperanza, Ibarra' : 'Potrero con eucaliptos y montañas en La Esperanza, Ibarra'}
        widths={[1024, 1600, 2400, 3200]}
        quality={85}
        sizes="(min-width: 1280px) 1216px, 100vw"
        class="w-full aspect-4/3 sm:aspect-21/9 object-cover"
        loading="eager"
      />
      <figcaption class={captionClass}>{t('farm.captionPasture')}</figcaption>
    </figure>
    <div class="mt-3 sm:mt-6 grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6">
      {photos.map((photo) => (
        <figure class={figureClass} tabindex="0">
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[600, 900, 1290, 1600]}
            quality={85}
            sizes="(min-width: 1024px) 33vw, 50vw"
            class="w-full aspect-3/4 object-cover"
            loading="lazy"
          />
          <figcaption class={captionClass}>{photo.caption}</figcaption>
        </figure>
      ))}
    </div>

    <!-- Tres frases cortas: qué criamos, el ciclo y sin químicos -->
    <div class="mt-14 sm:mt-20 space-y-4 font-serif text-[clamp(1.5rem,2.6vw,2.25rem)] leading-snug text-ink max-w-[40ch]">
      <p>{t('farm.line1')}</p>
      <p>{t('farm.line2')}</p>
      <p>{t('farm.line3')}</p>
    </div>
  </div>
</section>

<!-- Cierre: cómo llegar -->
<section class="bg-poncho text-white">
  <div class="faja-trim" aria-hidden="true"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-16 sm:py-20 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">
    <div>
      <h2 class="font-serif font-bold text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.04]">{t('farm.ctaTitle')}</h2>
      <p class="mt-4 text-lg text-white/85">{t('farm.ctaText')}</p>
    </div>
    <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        href={GOOGLE_MAPS_NAV_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center h-13 px-7 bg-white text-poncho font-bold hover:bg-[#f1ede6] transition-colors"
      >
        {t('about.openMaps')}
      </a>
      <a
        href={WAZE_NAV_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-white font-medium underline decoration-white/50 underline-offset-[6px] hover:decoration-white transition-colors"
      >
        {t('about.openWaze')}
      </a>
    </div>
  </div>
</section>

<script is:inline>
  // En pantallas táctiles no hay hover: tocar una foto muestra u oculta su detalle
  document.querySelectorAll('.farm-photo').forEach((figure) => {
    figure.addEventListener('click', () => {
      const open = !figure.classList.contains('is-open');
      document.querySelectorAll('.farm-photo.is-open').forEach((f) => f.classList.remove('is-open'));
      figure.classList.toggle('is-open', open);
    });
  });
</script>
