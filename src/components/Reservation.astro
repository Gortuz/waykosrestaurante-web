---
import { useTranslations, type Lang } from '../i18n/utils';
import { WHATSAPP_NUMBER, WHATSAPP_URL, PHONE_DISPLAY, OPENING_HOURS } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const guestKeys = ['booking.guest1', 'booking.guest2', 'booking.guest3', 'booking.guest4', 'booking.guest5', 'booking.guest6', 'booking.guest7', 'booking.guest8Plus'] as const;

// Etiquetas del mensaje de WhatsApp en el idioma de la página
const messageLabels = {
  intro: t('booking.msgIntro'),
  name: t('booking.msgName'),
  phone: t('booking.msgPhone'),
  date: t('booking.msgDate'),
  time: t('booking.msgTime'),
  guests: t('booking.msgGuests'),
  email: t('booking.msgEmail'),
  outro: t('booking.msgOutro'),
};

const fieldClass = 'w-full h-13 px-4 border border-rule bg-surface text-ink placeholder:text-ink-muted/80 text-base focus:border-ink transition-colors';
const labelClass = 'block text-sm font-medium text-ink mb-1.5';
---

<section id="reservas" class="scroll-mt-18 bg-surface-alt py-20 sm:py-28 px-4 sm:px-8">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-10">
    <div class="lg:col-span-4">
      <h2 class="font-serif font-bold text-[clamp(2.25rem,5vw,4rem)] leading-[1.02] text-ink">
        {t('booking.title')}
      </h2>
      <p class="mt-5 text-lg text-ink-muted max-w-[40ch]">
        {t('booking.subtitle')}
      </p>
      <p class="mt-8 pt-6 border-t border-rule text-ink-muted max-w-[40ch]">
        {t('booking.direct')}
        <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="font-bold text-accent-text underline underline-offset-4 decoration-2 whitespace-nowrap">{PHONE_DISPLAY}</a>.
      </p>
    </div>

    <form
      id="reservation-form"
      data-whatsapp={WHATSAPP_NUMBER}
      data-open-days={JSON.stringify(OPENING_HOURS.dayNumbers)}
      data-labels={JSON.stringify(messageLabels)}
      class="lg:col-span-8 bg-surface border border-rule p-6 sm:p-10 grid grid-cols-1 sm:grid-cols-6 gap-x-6 gap-y-6"
    >
      <div class="sm:col-span-3">
        <label for="booking-name" class={labelClass}>{t('booking.name')}</label>
        <input type="text" id="booking-name" name="name" required autocomplete="name" placeholder={t('booking.namePlaceholder')} class={fieldClass} />
      </div>

      <div class="sm:col-span-3">
        <label for="booking-phone" class={labelClass}>{t('booking.phone')}</label>
        <input type="tel" id="booking-phone" name="phone" required autocomplete="tel" placeholder={t('booking.phonePlaceholder')} class={fieldClass} />
      </div>

      <div class="sm:col-span-6">
        <label for="booking-email" class={labelClass}>{t('booking.email')}</label>
        <input type="email" id="booking-email" name="email" autocomplete="email" placeholder={t('booking.emailPlaceholder')} class={fieldClass} />
      </div>

      <div class="sm:col-span-2">
        <label for="booking-date" class={labelClass}>{t('booking.date')}</label>
        <input type="date" id="booking-date" name="date" required aria-describedby="booking-date-hint" class={fieldClass} />
      </div>

      <div class="sm:col-span-2">
        <label for="booking-time" class={labelClass}>{t('booking.time')}</label>
        <input
          type="time"
          id="booking-time"
          name="time"
          required
          value="13:00"
          min={OPENING_HOURS.opens}
          max={OPENING_HOURS.lastBooking}
          step="900"
          class={fieldClass}
        />
      </div>

      <div class="sm:col-span-2">
        <label for="booking-guests" class={labelClass}>{t('booking.guests')}</label>
        <div class="relative">
          <select id="booking-guests" name="guests" required class={`${fieldClass} pr-10 cursor-pointer`}>
            {guestKeys.map((key) => (
              <option value={t(key)} selected={key === 'booking.guest4'}>{t(key)}</option>
            ))}
          </select>
          <svg class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="square" d="M6 9l6 6 6-6" />
          </svg>
        </div>
      </div>

      <!-- Aviso cuando la fecha elegida cae en un día que normalmente no abrimos -->
      <p id="booking-date-hint" class="hidden sm:col-span-6 -mt-2 text-sm font-medium text-accent-text" role="status">
        {t('booking.closedDayHint')}
      </p>

      <div class="sm:col-span-6 pt-2 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
        <button
          type="submit"
          class="inline-flex items-center justify-center h-13 px-8 bg-accent hover:bg-accent-hover text-white font-bold text-base transition-colors cursor-pointer"
        >
          {t('booking.submit')}
        </button>
        <p class="text-sm text-ink-muted">{t('booking.helper')}</p>
      </div>
    </form>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('reservation-form');
  if (form) {
    const dateInput = document.getElementById('booking-date');
    const dateHint = document.getElementById('booking-date-hint');
    const openDays = JSON.parse(form.dataset.openDays || '[]');
    const labels = JSON.parse(form.dataset.labels || '{}');

    const toInputValue = (d) =>
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

    // Por defecto: hoy si abrimos, si no el próximo día de atención
    if (dateInput) {
      const today = new Date();
      dateInput.min = toInputValue(today);
      if (!dateInput.value) {
        const next = new Date(today);
        while (!openDays.includes(next.getDay())) next.setDate(next.getDate() + 1);
        dateInput.value = toInputValue(next);
      }

      // No bloqueamos otros días (feriados), solo avisamos
      const updateHint = () => {
        if (!dateHint || !dateInput.value) return;
        const [y, m, d] = dateInput.value.split('-').map(Number);
        const isOpenDay = openDays.includes(new Date(y, m - 1, d).getDay());
        dateHint.classList.toggle('hidden', isOpenDay);
      };
      dateInput.addEventListener('change', updateHint);
      updateHint();
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('booking-name').value;
      const phone = document.getElementById('booking-phone').value;
      const email = document.getElementById('booking-email').value;
      const date = document.getElementById('booking-date').value;
      const time = document.getElementById('booking-time').value;
      const guests = document.getElementById('booking-guests').value;

      let message = `${labels.intro}\n\n` +
        `• ${labels.name}: ${name}\n` +
        `• ${labels.phone}: ${phone}\n` +
        `• ${labels.date}: ${date}\n` +
        `• ${labels.time}: ${time}\n` +
        `• ${labels.guests}: ${guests}\n`;

      if (email) {
        message += `• ${labels.email}: ${email}\n`;
      }
      message += `\n${labels.outro}`;

      const whatsappUrl = `https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(message)}`;
      window.open(whatsappUrl, '_blank');
    });
  }
</script>
