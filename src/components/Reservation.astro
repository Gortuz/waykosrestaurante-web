---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="reservas" class="relative min-h-[calc(100vh-5rem)] scroll-mt-20 py-16 sm:py-20 lg:py-10 px-6 sm:px-8 flex flex-col justify-center overflow-hidden bg-[#ECE9E2] dark:bg-(--bg-secondary) transition-colors duration-200">
  <!-- Andean Isotipo Pattern Background (From official Wayko's emblem / favicon.svg) -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden select-none">
    <svg class="w-full h-full text-white/85 dark:text-white/4" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- Wayko's Isotipo Vector Definition -->
        <g id="waykos-isotipo-symbol">
          <g transform="translate(-72.123,-82.285)">
            <path d="m 83.232531,111.3155 c 1.743605,-0.0344 2.77548,0.90223 3.796771,1.92352 3.857625,3.86027 4.294188,3.8444 8.202083,-0.0873 2.264834,-2.24896 4.479396,-4.52173 6.762755,-6.74688 2.4421,-2.38125 4.10368,-2.35214 6.55902,0.0767 2.76225,2.7305 5.46629,5.51921 8.25235,8.2259 1.92352,1.8706 3.28877,1.82033 5.22817,-0.0344 0.89164,-0.85196 1.6801,-1.83356 2.64583,-2.57439 1.62454,-1.23825 3.37873,-1.10861 4.79954,0.29104 1.42081,1.39964 1.71715,3.29142 0.381,4.79425 a 105.23802,105.23802 0 0 1 -8.35289,8.46666 c -1.5875,1.42875 -3.43959,0.84138 -4.953,-0.68262 -2.8575,-2.88396 -5.75205,-5.73087 -8.6413,-8.58308 -2.15106,-2.11667 -3.175,-2.16694 -5.32077,-0.0714 -2.83633,2.79135 -5.577413,5.67531 -8.429621,8.43756 -2.360084,2.28336 -4.050771,2.2569 -6.35,-0.0318 Q 84.237948,121.1712 80.78249,117.5173 c -1.129771,-1.20385 -1.322917,-2.64583 -0.560917,-4.16454 0.661458,-1.30969 1.812396,-1.86266 3.010958,-2.03729 z" />
            <path d="m 111.87103,89.857792 c -0.28575,-4.077229 -6.58548,-7.572375 -6.58548,-7.572375 0,0 -6.334123,3.439583 -6.65956,7.508875 -0.325438,4.069292 6.5696,11.035768 6.5696,11.035768 0,0 6.96384,-6.895039 6.67544,-10.972268 z m -6.63046,1.701271 c -0.87312,0 -1.5875,-0.486833 -1.57427,-1.0795 0.0132,-0.592667 0.71173,-1.058333 1.5875,-1.058333 0.87577,0 1.5875,0.486833 1.5875,1.076854 0,0.590021 -0.7276,1.063625 -1.60073,1.060979 z" />
            <path d="m 105.19559,134.35806 c 0,0 -6.905621,6.97177 -6.5696,11.03842 0.33602,4.06664 6.65956,7.50887 6.65956,7.50887 0,0 6.29973,-3.49514 6.58548,-7.57237 0.28575,-4.07723 -6.67544,-10.97492 -6.67544,-10.97492 z m 1.62984,10.33463 c 0,0.59266 -0.70115,1.07421 -1.5875,1.0795 -0.88636,0.005 -1.5875,-0.47096 -1.5875,-1.05834 0,-0.58737 0.70114,-1.05833 1.57427,-1.07685 0.87312,-0.0185 1.59808,0.46567 1.60073,1.05569 z" />
            <path d="m 89.984698,93.704834 c -3.085042,-2.682875 -10.011833,-0.6985 -10.011833,-0.6985 0,0 -2.055813,6.918854 0.590021,10.030356 2.645833,3.1115 12.448645,3.15648 12.448645,3.15648 0,0 0.05821,-9.797524 -3.026833,-12.488336 z m -3.487208,5.900208 c -0.619125,0.613838 -1.457854,0.772588 -1.875896,0.351896 -0.418042,-0.420688 -0.248708,-1.256771 0.370417,-1.870604 0.619125,-0.613834 1.4605,-0.772584 1.875895,-0.351896 0.415396,0.420687 0.248709,1.262062 -0.370416,1.870604 z" />
            <path d="m 117.35584,105.78835 c 0,0 9.78959,-0.0476 12.4513,-3.15912 2.6617,-3.111501 0.6006,-10.017125 0.6006,-10.017125 0,0 -6.92679,-1.984375 -10.01183,0.695854 -3.08505,2.680229 -3.04007,12.480391 -3.04007,12.480391 z m 6.15686,-8.466662 c 0.41539,-0.418042 1.25412,-0.264584 1.87589,0.351896 0.62177,0.616479 0.79375,1.452562 0.36777,1.870604 -0.42597,0.418041 -1.25412,0.264583 -1.87325,-0.34925 -0.61912,-0.613834 -0.78581,-1.447271 -0.37041,-1.867959 z" />
            <path d="m 80.361802,131.91067 c 0.169334,0.17991 1.0795,1.18533 2.341563,2.44739 l -0.132292,-0.13758 z" />
            <path d="m 85.505302,136.98537 c 2.534709,2.20134 5.347229,4.0984 6.789208,3.23321 2.005542,-1.20385 7.239,-6.71248 10.287,-10.00918 a 3.0691666,3.0691666 0 0 1 4.53496,0.0318 c 3.43958,3.82058 9.82662,10.58333 11.59933,10.19175 1.32292,-0.2884 4.7625,-3.25438 7.67292,-5.92932 l 9.66787,-9.28158 c 1.85209,-1.97644 2.08227,-4.04812 0.6059,-5.60387 -1.60338,-1.68275 -3.58246,-1.48696 -5.73352,0.62177 -3.14061,3.07975 -6.24946,6.19654 -9.398,9.26041 -2.33098,2.27806 -3.50838,2.28071 -5.77586,0.0291 -2.51618,-2.50032 -4.97152,-5.06148 -7.50622,-7.54327 a 4.5190833,4.5190833 0 0 0 -6.33148,0.0185 c -2.59292,2.55323 -5.124983,5.16995 -7.725837,7.70995 -2.2225,2.17223 -3.370792,2.20928 -5.580062,0.0503 -2.963334,-2.91042 -5.820834,-5.9055 -8.755063,-8.83973 -2.934229,-2.93423 -4.8895,-3.32582 -6.6675,-1.44992 -1.778,1.8759 -1.36525,3.50308 1.49225,6.47965 l 5.691188,5.94518 v 0 l 2.20927,2.30982 c 0.418042,0.0556 2.246313,1.82827 2.923646,2.77547 z" />
            <path d="m 85.505302,136.98537 c -0.677333,-0.95779 -2.505604,-2.71991 -2.934229,-2.76489 l 0.132292,0.13758 c 0.820208,0.82021 1.788583,1.7489 2.801937,2.62731 z" />
          </g>
        </g>

        <!-- Seamless Staggered Pattern matching Figma Desktop - 3.png -->
        <pattern id="waykos-andean-pattern" width="100" height="96" patternUnits="userSpaceOnUse">
          <g fill="currentColor">
            <!-- Row 1 center -->
            <use href="#waykos-isotipo-symbol" transform="translate(50, 0) scale(1.05) translate(-32.75, -35.3)" />
            <!-- Row 2 left & right -->
            <use href="#waykos-isotipo-symbol" transform="translate(0, 48) scale(1.05) translate(-32.75, -35.3)" />
            <use href="#waykos-isotipo-symbol" transform="translate(100, 48) scale(1.05) translate(-32.75, -35.3)" />
            <!-- Row 3 center (wrapping vertically with Row 1) -->
            <use href="#waykos-isotipo-symbol" transform="translate(50, 96) scale(1.05) translate(-32.75, -35.3)" />
          </g>
        </pattern>
      </defs>

      <rect width="100%" height="100%" fill="url(#waykos-andean-pattern)" />
    </svg>
  </div>

  <div class="max-w-4xl mx-auto relative z-10">
    <!-- Header info from Desktop - 3.png -->
    <div class="text-left mb-6 lg:mb-8">
      <p class="text-xs uppercase font-bold tracking-[0.2em] text-brand mb-2 lg:mb-3">
        {t('booking.tag')}
      </p>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-(--text-title-secondary) dark:text-white tracking-tight">
        {t('booking.title')}
      </h2>
      <p class="mt-2 lg:mt-3 text-base sm:text-lg text-(--text-muted) font-normal max-w-2xl leading-relaxed">
        {t('booking.subtitle')}
      </p>
    </div>

    <!-- Centered Form Card from Desktop - 3.png -->
    <div class="bg-(--bg-primary) dark:bg-(--bg-primary) rounded-3xl p-6 sm:p-10 lg:p-8 shadow-xl border border-(--border-subtle)">
      <form id="reservation-form" class="space-y-5 lg:space-y-4">
        <!-- Row 1: Name & Phone -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="booking-name" class="block text-sm font-medium text-(--text-title-secondary) dark:text-neutral-200 mb-2">
              {t('booking.name')} *
            </label>
            <input
              type="text"
              id="booking-name"
              name="name"
              required
              placeholder={t('booking.namePlaceholder')}
              class="w-full h-[52px] px-4 rounded-xl border border-(--border-subtle) bg-(--bg-secondary) text-(--text-body) placeholder:text-(--text-muted) text-base focus:outline-none focus:ring-2 focus:ring-brand transition-all"
            />
          </div>

          <div>
            <label for="booking-phone" class="block text-sm font-medium text-(--text-title-secondary) dark:text-neutral-200 mb-2">
              {t('booking.phone')} *
            </label>
            <input
              type="tel"
              id="booking-phone"
              name="phone"
              required
              placeholder={t('booking.phonePlaceholder')}
              class="w-full h-[52px] px-4 rounded-xl border border-(--border-subtle) bg-(--bg-secondary) text-(--text-body) placeholder:text-(--text-muted) text-base focus:outline-none focus:ring-2 focus:ring-brand transition-all"
            />
          </div>
        </div>

        <!-- Row 2: Email (optional) -->
        <div>
          <label for="booking-email" class="block text-sm font-medium text-(--text-title-secondary) dark:text-neutral-200 mb-2">
            {t('booking.email')}
          </label>
          <input
            type="email"
            id="booking-email"
            name="email"
            placeholder={t('booking.emailPlaceholder')}
            class="w-full h-[52px] px-4 rounded-xl border border-(--border-subtle) bg-(--bg-secondary) text-(--text-body) placeholder:text-(--text-muted) text-base focus:outline-none focus:ring-2 focus:ring-brand transition-all"
          />
        </div>

        <!-- Row 3: Date, Time & Number of Guests -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div>
            <label for="booking-date" class="block text-sm font-medium text-(--text-title-secondary) dark:text-neutral-200 mb-2">
              {t('booking.date')} *
            </label>
            <input
              type="date"
              id="booking-date"
              name="date"
              required
              class="w-full h-[52px] px-4 rounded-xl border border-(--border-subtle) bg-(--bg-secondary) text-(--text-body) text-base focus:outline-none focus:ring-2 focus:ring-brand transition-all"
            />
          </div>

          <div>
            <label for="booking-time" class="block text-sm font-medium text-(--text-title-secondary) dark:text-neutral-200 mb-2">
              {t('booking.time')} *
            </label>
            <input
              type="time"
              id="booking-time"
              name="time"
              required
              value="13:00"
              class="w-full h-[52px] px-4 rounded-xl border border-(--border-subtle) bg-(--bg-secondary) text-(--text-body) text-base focus:outline-none focus:ring-2 focus:ring-brand transition-all"
            />
          </div>

          <div>
            <label for="booking-guests" class="block text-sm font-medium text-(--text-title-secondary) dark:text-neutral-200 mb-2">
              {t('booking.guests')} *
            </label>
            <div class="relative">
              <select
                id="booking-guests"
                name="guests"
                required
                class="w-full h-[52px] px-4 pr-10 rounded-xl border border-(--border-subtle) bg-(--bg-secondary) text-(--text-body) text-base focus:outline-none focus:ring-2 focus:ring-brand appearance-none cursor-pointer transition-all"
              >
                <option value={t('booking.guest1')}>{t('booking.guest1')}</option>
                <option value={t('booking.guest2')}>{t('booking.guest2')}</option>
                <option value={t('booking.guest3')}>{t('booking.guest3')}</option>
                <option value={t('booking.guest4')} selected>{t('booking.guest4')}</option>
                <option value={t('booking.guest8Plus')}>{t('booking.guest8Plus')}</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 text-(--text-muted)">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Microcopy notice -->
        <p class="text-center text-sm text-(--text-muted) font-medium pt-2">
          {t('booking.helper')}
        </p>

        <!-- Submit Button from Desktop - 3.png -->
        <div class="text-center">
          <button
            type="submit"
            class="w-full sm:w-auto min-w-70 px-10 py-4 rounded-xl bg-brand hover:bg-brand-hover text-white font-bold text-sm tracking-wider uppercase shadow-lg transition-all duration-200 transform hover:-translate-y-0.5 cursor-pointer"
          >
            {t('booking.submit')}
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('reservation-form');
  if (form) {
    // Set default date to today or upcoming weekend
    const dateInput = document.getElementById('booking-date');
    if (dateInput && !dateInput.value) {
      const today = new Date();
      const yyyy = today.getFullYear();
      const mm = String(today.getMonth() + 1).padStart(2, '0');
      const dd = String(today.getDate()).padStart(2, '0');
      dateInput.value = `${yyyy}-${mm}-${dd}`;
      dateInput.min = `${yyyy}-${mm}-${dd}`;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('booking-name').value;
      const phone = document.getElementById('booking-phone').value;
      const email = document.getElementById('booking-email').value;
      const date = document.getElementById('booking-date').value;
      const time = document.getElementById('booking-time').value;
      const guests = document.getElementById('booking-guests').value;

      let message = `¡Hola Wayko's! Deseo reservar una mesa:\n\n` +
        `• Nombre: ${name}\n` +
        `• Teléfono: ${phone}\n` +
        `• Fecha: ${date}\n` +
        `• Hora: ${time}\n` +
        `• Personas: ${guests}\n`;

      if (email) {
        message += `• Email: ${email}\n`;
      }
      message += `\n¿Tienen disponibilidad para confirmar mi lugar? ¡Muchas gracias!`;

      const whatsappNumber = '593969143757';
      const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
      window.open(whatsappUrl, '_blank');
    });
  }
</script>
