---
import { menuItems } from '../data/menu';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categories = [
  { id: 'all', label: t('menu.tabAll') },
  { id: 'entradas', label: t('menu.tabEntradas') },
  { id: 'principales', label: t('menu.tabPrincipales') },
  { id: 'pizzas', label: t('menu.tabPizzas') },
  { id: 'bebidas', label: t('menu.tabBebidas') }
];
---

<div
  id="menu-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 lg:p-10 bg-black/75 backdrop-blur-sm transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
>
  <div class="relative w-full max-w-5xl max-h-[90vh] flex flex-col bg-(--bg-primary) dark:bg-(--bg-primary) rounded-3xl border border-(--border-subtle) shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
    <!-- Modal Header -->
    <div class="p-6 sm:p-8 border-b border-(--border-subtle) flex items-center justify-between bg-(--bg-secondary)">
      <div>
        <span class="text-xs uppercase font-bold tracking-widest text-brand">Wayko's Rural</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-(--text-title-secondary) dark:text-white mt-1">
          {t('menu.modalTitle')}
        </h2>
      </div>
      <button
        type="button"
        id="close-menu-modal-btn"
        aria-label={t('menu.close')}
        class="w-10 h-10 rounded-full border border-(--border-subtle) bg-(--bg-primary) hover:bg-(--bg-tertiary) flex items-center justify-center text-(--text-body) transition-colors cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Category Tabs -->
    <div class="px-6 py-4 border-b border-(--border-subtle) flex gap-2 overflow-x-auto no-scrollbar">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-category={cat.id}
          class:list={[
            "menu-tab px-4 py-2 rounded-full text-xs sm:text-sm font-semibold tracking-wide transition-all cursor-pointer whitespace-nowrap",
            idx === 0
              ? "bg-brand text-white shadow-xs"
              : "bg-(--bg-secondary) text-(--text-muted) hover:text-(--text-body) border border-(--border-subtle)"
          ]}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Menu Items List -->
    <div class="p-6 sm:p-8 overflow-y-auto max-h-[calc(90vh-180px)] space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="menu-items-container">
        {menuItems.map((item) => (
          <div
            class="menu-item p-5 rounded-2xl bg-(--bg-secondary) border border-(--border-subtle) flex flex-col justify-between hover:border-brand/40 transition-colors"
            data-item-cat={item.category}
          >
            <div>
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-serif text-lg font-bold text-(--text-title-secondary) dark:text-white">
                  {item.name[lang]}
                </h3>
                <span class="font-serif text-base font-bold text-brand whitespace-nowrap">
                  {item.price}
                </span>
              </div>
              <p class="mt-2 text-sm text-(--text-muted) leading-relaxed">
                {item.description[lang]}
              </p>
            </div>
            {item.popular && (
              <div class="mt-3">
                <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-brand-accent bg-brand-accent/10 px-2 py-0.5 rounded-md">
                  Recomendado de la casa
                </span>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const modal = document.getElementById('menu-modal');
  const openBtn = document.getElementById('open-menu-modal-btn');
  const closeBtn = document.getElementById('close-menu-modal-btn');
  const tabs = document.querySelectorAll('.menu-tab');
  const items = document.querySelectorAll('.menu-item');

  function openModal() {
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }

  if (openBtn) openBtn.addEventListener('click', openModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  // Filter tabs
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const cat = tab.getAttribute('data-category');
      tabs.forEach((t) => {
        t.classList.remove('bg-brand', 'text-white', 'shadow-xs');
        t.classList.add('bg-(--bg-secondary)', 'text-(--text-muted)');
      });
      tab.classList.add('bg-brand', 'text-white', 'shadow-xs');
      tab.classList.remove('bg-(--bg-secondary)', 'text-(--text-muted)');

      items.forEach((item) => {
        const itemCat = item.getAttribute('data-item-cat');
        if (cat === 'all' || itemCat === cat) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });
  });
</script>
