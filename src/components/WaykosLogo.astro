---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
  inverted?: boolean;
}

const { lang, class: className = "h-8 sm:h-10 w-auto", inverted = false } = Astro.props;
const t = useTranslations(lang);
const homeUrl = lang === 'en' ? '/en/' : '/';
---

<a href={homeUrl} class="inline-flex items-center shrink-0" aria-label={t('nav.home')}>
  <img
    src="/waykos-horizontal.svg"
    alt=""
    width="1182"
    height="275"
    class:list={['waykos-logo-svg object-contain hover:opacity-80', className, { 'is-inverted': inverted }]}
    loading="eager"
  />
</a>
