---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className = "h-10 sm:h-12 md:h-14 w-auto" } = Astro.props;
const t = useTranslations(lang);
const homeUrl = lang === 'en' ? '/en/' : '/';
---

<a href={homeUrl} class="inline-flex items-center group shrink-0" aria-label={t('nav.home')}>
  <img
    src="/waykos-horizontal.svg"
    alt=""
    class={`waykos-logo-svg ${className} object-contain transition-all duration-200 group-hover:opacity-90`}
    loading="eager"
    fetchpriority="high"
  />
</a>
