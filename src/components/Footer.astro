---
import WaykosLogo from './WaykosLogo.astro';
import { useTranslations, routes, type Lang } from '../i18n/utils';
import { SITE_NAME, INSTAGRAM_URL, FACEBOOK_URL, WHATSAPP_URL, PHONE_DISPLAY, MENU_PDF_PATH } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contactLinks = [
  { href: WHATSAPP_URL, label: `WhatsApp ${PHONE_DISPLAY}`, aria: t('footer.whatsappLabel') },
  { href: INSTAGRAM_URL, label: 'Instagram', aria: t('footer.instagramLabel') },
  { href: FACEBOOK_URL, label: 'Facebook', aria: t('footer.facebookLabel') },
];
---

<footer class="bg-carbon text-[#eee7df]">
  <div class="faja-trim" aria-hidden="true"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-16 pb-10">
    <div class="grid gap-10 md:grid-cols-12 items-end">
      <div class="md:col-span-5">
        <WaykosLogo lang={lang} inverted class="h-10 w-auto" />
        <p class="mt-4 text-[#b8ada3] max-w-[40ch]">{t('footer.slogan')}</p>
      </div>

      <ul class="md:col-span-7 flex flex-wrap md:justify-end gap-x-8 gap-y-3">
        {contactLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.aria}
              class="font-medium underline decoration-white/30 underline-offset-4 hover:decoration-white transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href={routes.farm[lang]}
            class="font-medium underline decoration-white/30 underline-offset-4 hover:decoration-white transition-colors"
          >
            {t('nav.farm')}
          </a>
        </li>
        <li>
          <a
            href={MENU_PDF_PATH}
            target="_blank"
            rel="noopener"
            class="font-medium underline decoration-white/30 underline-offset-4 hover:decoration-white transition-colors"
          >
            {t('specialties.cta')}
          </a>
        </li>
      </ul>
    </div>

    <p class="mt-12 pt-6 border-t border-white/15 text-sm text-[#b8ada3]">
      © {new Date().getFullYear()} {SITE_NAME}. {t('footer.rights')}
    </p>
  </div>
</footer>
