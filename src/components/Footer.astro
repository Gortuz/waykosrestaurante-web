---
import WaykosLogo from './WaykosLogo.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Enlaces oficiales de Redes Sociales y Contacto
const INSTAGRAM_URL = 'https://www.instagram.com/waykosrestaurante/';
const FACEBOOK_URL = 'https://www.facebook.com/waykosrestaurante';
const WHATSAPP_NUMBER = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '593969143757';
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}`;
---

<footer class="bg-(--bg-primary) border-t border-(--border-subtle) py-12 px-6 sm:px-8 transition-colors duration-200">
  <div class="max-w-7xl mx-auto">
    <!-- Main Header: Brand on left, Socials on right -->
    <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-8 pb-10 border-b border-(--border-subtle) text-center md:text-left">
      <!-- Brand Information -->
      <div class="flex flex-col items-center md:items-start max-w-lg">
        <WaykosLogo />
        <p class="mt-4 text-sm text-(--text-muted) leading-relaxed">
          {t('footer.slogan')}
        </p>
        <p class="mt-1.5 text-xs text-(--text-muted)">
          {t('about.location')}
        </p>
      </div>

      <!-- Social Media Links -->
      <div class="flex flex-col items-center md:items-end gap-3">
        <span class="text-xs font-semibold text-(--text-muted) uppercase tracking-wider">
          {t('footer.follow')}
        </span>
        <div class="flex items-center gap-3">
          <!-- Instagram -->
          <a
            href={INSTAGRAM_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de Wayko's Restaurante"
            class="w-10 h-10 rounded-full flex items-center justify-center bg-(--bg-secondary) border border-(--border-subtle) text-(--text-muted) hover:text-white hover:bg-[#E1306C] hover:border-[#E1306C] transition-all duration-200 shadow-xs hover:shadow-md transform hover:-translate-y-0.5"
            title="Instagram @waykosrestaurante"
          >
            <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
          </a>

          <!-- Facebook -->
          <a
            href={FACEBOOK_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook de Wayko's Restaurante"
            class="w-10 h-10 rounded-full flex items-center justify-center bg-(--bg-secondary) border border-(--border-subtle) text-(--text-muted) hover:text-white hover:bg-[#1877F2] hover:border-[#1877F2] transition-all duration-200 shadow-xs hover:shadow-md transform hover:-translate-y-0.5"
            title="Facebook @waykosrestaurante"
          >
            <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <!-- WhatsApp -->
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp de Wayko's Restaurante"
            class="w-10 h-10 rounded-full flex items-center justify-center bg-(--bg-secondary) border border-(--border-subtle) text-(--text-muted) hover:text-white hover:bg-[#25D366] hover:border-[#25D366] transition-all duration-200 shadow-xs hover:shadow-md transform hover:-translate-y-0.5"
            title="WhatsApp (+593 96 914 3757)"
          >
            <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Details -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-(--text-muted)">
      <p>© {new Date().getFullYear()} Wayko's Restaurante Rural. {t('footer.rights')}</p>
      <p>Diseño y Experiencia Gastronómica Tradicional</p>
    </div>
  </div>
</footer>
