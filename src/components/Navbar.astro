---
import WaykosLogo from './WaykosLogo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguagePicker from './LanguagePicker.astro';
import { useTranslations, routes, type Lang, type PageKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  page?: PageKey;
}

const { lang, page = 'home' } = Astro.props;
const t = useTranslations(lang);
const home = routes.home[lang];

// Primero las secciones de la portada (hacen scroll); al final, separada, la granja,
// que es la única que lleva a otra página.
const links = [
  { section: 'menu', href: `${home}#menu`, label: t('nav.menu') },
  { section: 'reservas', href: `${home}#reservas`, label: t('nav.reservations') },
  { section: 'equipo', href: `${home}#equipo`, label: t('nav.team') },
  { section: 'nosotros', href: `${home}#nosotros`, label: t('nav.about') },
];
const farmLink = { href: routes.farm[lang], label: t('nav.farm'), current: page === 'farm' };
---

<header class="sticky top-0 z-40 w-full bg-surface/95 backdrop-blur-sm border-b border-rule">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 h-18 flex items-center justify-between gap-4">
    <WaykosLogo lang={lang} class="h-7 sm:h-9 w-auto" />

    <div class="flex items-center gap-6 lg:gap-10">
      <nav class="hidden lg:block" aria-label="Principal">
        <ul class="flex items-center gap-6 lg:gap-7 text-[0.95rem] font-medium">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link py-1 border-b-2 border-transparent text-ink hover:border-accent transition-colors duration-150"
                data-section={link.section}
              >
                {link.label}
              </a>
            </li>
          ))}
          <li class="h-5 w-px bg-rule" aria-hidden="true"></li>
          <li>
            <a
              href={farmLink.href}
              class:list={[
                'py-1 border-b-2 text-ink hover:border-accent transition-colors duration-150',
                farmLink.current ? 'border-accent text-accent-text' : 'border-transparent',
              ]}
              aria-current={farmLink.current ? 'page' : undefined}
            >
              {farmLink.label}
            </a>
          </li>
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <LanguagePicker currentLang={lang} page={page} />
        <ThemeToggle label={t('nav.themeToggle')} />
        <button
          id="mobile-menu-toggle"
          type="button"
          class="inline-flex lg:hidden items-center justify-center w-10 h-10 border border-rule text-ink hover:border-ink transition-colors cursor-pointer"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label={t('nav.openMenu')}
        >
          <svg id="hamburger-icon" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="square" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="square" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-rule bg-surface">
    <ul class="max-w-7xl mx-auto px-4 sm:px-8 py-2 font-serif text-2xl">
      {links.map((link) => (
        <li class="border-b border-rule">
          <a
            href={link.href}
            class="mobile-nav-link block py-4 text-ink hover:text-accent-text transition-colors"
            data-section={link.section}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="border-t-2 border-rule-accent">
        <a
          href={farmLink.href}
          class:list={['mobile-nav-link block py-4 hover:text-accent-text transition-colors', farmLink.current ? 'text-accent-text' : 'text-ink']}
          aria-current={farmLink.current ? 'page' : undefined}
        >
          {farmLink.label}
        </a>
      </li>
    </ul>
  </div>
</header>

<script is:inline>
  const mobileToggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function setMobileMenu(open) {
    if (!mobileMenu || !mobileToggleBtn || !hamburgerIcon || !closeIcon) return;
    mobileMenu.classList.toggle('hidden', !open);
    mobileToggleBtn.setAttribute('aria-expanded', String(open));
    hamburgerIcon.classList.toggle('hidden', open);
    closeIcon.classList.toggle('hidden', !open);
  }

  if (mobileToggleBtn) {
    mobileToggleBtn.addEventListener('click', () => {
      setMobileMenu(mobileToggleBtn.getAttribute('aria-expanded') !== 'true');
    });
  }

  mobileLinks.forEach((link) => link.addEventListener('click', () => setMobileMenu(false)));

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('hidden')) {
      setMobileMenu(false);
    }
  });

  // Marca la sección visible en la navegación
  const allNavLinks = [...document.querySelectorAll('.nav-link'), ...mobileLinks];
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = entry.target.getAttribute('id');
        allNavLinks.forEach((link) => {
          const active = link.getAttribute('data-section') === id;
          link.classList.toggle('border-accent', active);
          link.classList.toggle('text-accent-text', active);
          if (active) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
      });
    },
    { root: null, rootMargin: '-20% 0px -70% 0px', threshold: 0 }
  );
  document.querySelectorAll('section[id]').forEach((section) => observer.observe(section));
</script>
