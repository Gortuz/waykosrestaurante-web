---
import { useTranslations, type Lang } from '../i18n/utils';
import { GOOGLE_MAPS_EMBED_SRC, GOOGLE_MAPS_NAV_URL, WAZE_NAV_URL } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const facts = [
  { term: t('about.hoursTitle'), detail: t('about.hours') },
  { term: t('about.addressTitle'), detail: t('about.address') },
  { term: t('about.locationTitle'), detail: t('about.location') },
];
---

<section id="nosotros" class="scroll-mt-18 bg-surface-alt py-20 sm:py-28 px-4 sm:px-8">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-12">
    <div class="lg:col-span-5">
      <h2 class="font-serif font-bold text-[clamp(2.25rem,5vw,4rem)] leading-[1.02] text-ink max-w-[14ch]">
        {t('about.title')}
      </h2>
      <div class="mt-6 space-y-4 text-lg text-ink-muted max-w-[46ch]">
        <p>{t('about.p1')}</p>
        <p>{t('about.p2')}</p>
      </div>

      <dl class="mt-10 border-t-2 border-accent">
        {facts.map((fact) => (
          <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4 border-b border-rule">
            <dt class="font-serif font-semibold text-ink">{fact.term}</dt>
            <dd class="text-ink-muted">{fact.detail}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="lg:col-span-7 flex flex-col">
      <div class="relative w-full aspect-4/3 lg:aspect-auto lg:grow min-h-72 bg-surface border border-rule overflow-hidden">
        <iframe
          src={GOOGLE_MAPS_EMBED_SRC}
          class="absolute inset-0 w-full h-full border-0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title={t('about.mapIframeTitle')}
        ></iframe>
      </div>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={GOOGLE_MAPS_NAV_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center h-12 px-6 bg-accent hover:bg-accent-hover text-white font-bold transition-colors"
        >
          {t('about.openMaps')}
        </a>
        <a
          href={WAZE_NAV_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center h-12 px-6 border-2 border-ink text-ink font-bold hover:bg-ink hover:text-surface transition-colors"
        >
          {t('about.openWaze')}
        </a>
      </div>
    </div>
  </div>
</section>
