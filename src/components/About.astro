---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/utils';
import { GOOGLE_MAPS_EMBED_SRC, GOOGLE_MAPS_NAV_URL, WAZE_NAV_URL } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const facts = [
  { icon: 'clock', term: t('about.hoursTitle'), detail: t('about.hours') },
  { icon: 'pin', term: t('about.addressTitle'), detail: t('about.address') },
] as const;

const services = [
  { icon: 'parking', label: t('about.parking') },
  { icon: 'tree', label: t('about.greenAreas') },
  { icon: 'paw', label: t('about.pets') },
] as const;
---

<section id="nosotros" class="scroll-mt-18 bg-surface-alt py-20 sm:py-28 px-4 sm:px-8">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-12">
    <div class="lg:col-span-5">
      <h2 class="font-serif font-bold text-[clamp(2.25rem,5vw,4rem)] leading-[1.02] text-ink max-w-[14ch]">
        {t('about.title')}
      </h2>
      <p class="mt-6 text-lg text-ink-muted max-w-[46ch]">{t('about.p1')}</p>

      <dl class="mt-10 border-t-2 border-rule-accent">
        {facts.map((fact) => (
          <div class="grid grid-cols-[2rem_6rem_1fr] sm:grid-cols-[2rem_7rem_1fr] items-start gap-x-3 py-4 border-b border-rule">
            <Icon name={fact.icon} class="w-6 h-6 text-accent-text mt-px" />
            <dt class="font-serif font-semibold text-ink">{fact.term}</dt>
            <dd class="text-ink-muted">{fact.detail}</dd>
          </div>
        ))}
      </dl>

      <!-- Servicios del lugar: un ícono por servicio -->
      <h3 class="sr-only">{t('about.servicesTitle')}</h3>
      <ul class="mt-6 grid grid-cols-3 gap-3">
        {services.map((service) => (
          <li class="group flex flex-col items-center text-center gap-2.5 p-4 border border-rule hover:border-rule-accent transition-colors">
            <span class="inline-flex items-center justify-center w-12 h-12 border-2 border-rule-accent text-accent-text transition-colors group-hover:bg-accent group-hover:border-accent group-hover:text-white">
              <Icon name={service.icon} class="w-6 h-6" />
            </span>
            <span class="text-sm text-ink leading-tight">{service.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="lg:col-span-7 flex flex-col">
      <div class="relative w-full aspect-4/3 lg:aspect-auto lg:grow min-h-72 bg-surface border border-rule overflow-hidden">
        <iframe
          src={GOOGLE_MAPS_EMBED_SRC}
          class="absolute inset-0 w-full h-full border-0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title={t('about.mapIframeTitle')}
        ></iframe>
      </div>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={GOOGLE_MAPS_NAV_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center h-12 px-6 bg-accent hover:bg-accent-hover text-white font-bold transition-colors"
        >
          {t('about.openMaps')}
        </a>
        <a
          href={WAZE_NAV_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center h-12 px-6 border-2 border-ink text-ink font-bold hover:bg-ink hover:text-surface transition-colors"
        >
          {t('about.openWaze')}
        </a>
      </div>
    </div>
  </div>
</section>
