---
interface Props {
  currentLang: "es" | "en";
}

const { currentLang } = Astro.props;
const targetUrl = currentLang === "es" ? "/en/" : "/";
const targetTitle = currentLang === "es" ? "Switch to English" : "Cambiar a español";
const targetHreflang = currentLang === "es" ? "en" : "es";
---

<a
  href={targetUrl}
  hreflang={targetHreflang}
  aria-label={targetTitle}
  title={targetTitle}
  class="language-toggle-btn inline-flex items-center h-10 border border-rule text-sm font-medium select-none shrink-0 hover:border-ink transition-colors"
>
  <span class:list={["px-2.5 h-full inline-flex items-center", currentLang === "es" ? "bg-ink text-surface" : "text-ink-muted"]}>ES</span>
  <span class:list={["px-2.5 h-full inline-flex items-center", currentLang === "en" ? "bg-ink text-surface" : "text-ink-muted"]}>EN</span>
</a>

<script is:inline>
  // Conserva la posición de scroll al cambiar de idioma
  if (!window.__langToggleInitialized) {
    window.__langToggleInitialized = true;

    document.addEventListener("click", (e) => {
      const toggle = e.target.closest(".language-toggle-btn");
      if (!toggle) return;
      sessionStorage.setItem("waykos-lang-scroll", window.scrollY.toString());
    });

    const savedScroll = sessionStorage.getItem("waykos-lang-scroll");
    if (savedScroll !== null) {
      sessionStorage.removeItem("waykos-lang-scroll");
      if (window.location.hash) {
        history.replaceState(null, "", window.location.pathname);
      }
      window.scrollTo({ top: parseInt(savedScroll, 10), behavior: "instant" });
    }
  }
</script>
