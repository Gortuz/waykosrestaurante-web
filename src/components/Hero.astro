---
import { Image } from 'astro:assets';
import heroImg from '../assets/restaurante/hero-cordero.webp';
import { useTranslations, type Lang } from '../i18n/utils';
import { WHATSAPP_URL, PHONE_DISPLAY } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === 'en' ? '/en' : '';
---

<section id="hero" class="relative">
  <div class="relative h-[calc(100svh-4.5rem)] min-h-[32rem] max-h-[56rem] overflow-hidden bg-carbon">
    <Image
      src={heroImg}
      alt={lang === 'en' ? "Lamb steak from the grill at Wayko's, La Esperanza, Ibarra" : "Steak de cordero a la parrilla en Wayko's, La Esperanza, Ibarra"}
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      class="hero-image absolute inset-0 w-full h-full object-cover object-[center_60%]"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Solo oscurece la parte inferior, donde va el texto -->
    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/30 to-transparent" aria-hidden="true"></div>

    <div class="relative h-full max-w-7xl mx-auto px-4 sm:px-8 flex flex-col justify-end pb-12 sm:pb-16">
      <h1 class="font-serif text-white font-bold leading-[0.95] tracking-[-0.01em] text-[clamp(2.75rem,7.5vw,6.25rem)] max-w-[12ch]">
        {t('hero.title')}
      </h1>
      <p class="mt-5 max-w-[46ch] text-lg sm:text-xl text-white/85 leading-snug">
        {t('hero.subtitle')}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href={`${prefix}#reservas`}
          class="inline-flex items-center h-13 px-7 bg-poncho hover:bg-[#6e040b] text-white font-bold text-base transition-colors"
        >
          {t('hero.ctaReserve')}
        </a>
        <a
          href={`${prefix}#menu`}
          class="text-white font-medium underline decoration-white/50 underline-offset-[6px] hover:decoration-white transition-colors"
        >
          {t('hero.ctaMenu')}
        </a>
      </div>
    </div>
  </div>

  <!-- Franja tejida: datos prácticos sobre el rojo poncho -->
  <div class="bg-poncho text-white">
    <div class="faja-trim" aria-hidden="true"></div>
    <dl class="max-w-7xl mx-auto px-4 sm:px-8 py-4 grid grid-cols-1 md:grid-cols-[auto_auto_auto] md:justify-between gap-x-10 gap-y-1.5 text-[0.95rem]">
      <div class="flex gap-2">
        <dt class="sr-only">{t('about.hoursTitle')}</dt>
        <dd>{t('strip.hours')}</dd>
      </div>
      <div class="flex gap-2">
        <dt class="sr-only">{t('about.addressTitle')}</dt>
        <dd>{t('strip.place')}</dd>
      </div>
      <div class="flex gap-2">
        <dt class="text-white/70">{t('strip.whatsapp')}</dt>
        <dd>
          <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="font-bold underline decoration-white/40 underline-offset-4 hover:decoration-white">
            {PHONE_DISPLAY}
          </a>
        </dd>
      </div>
    </dl>
  </div>
</section>
