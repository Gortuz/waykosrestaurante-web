---
import { Image } from 'astro:assets';
import borregoNegro from '../assets/fotos/granja-borrego-negro.webp';
import gallo from '../assets/fotos/granja-gallo.webp';
import rebano from '../assets/fotos/granja-rebano.webp';
import { useTranslations, routes, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const en = lang === 'en';

const photos = [
  { src: borregoNegro, alt: en ? 'Black-faced sheep looking at the camera in the barn' : 'Borrego de cara negra mirando a la cámara en el establo' },
  { src: gallo, alt: en ? 'Free-range rooster on the farm' : 'Gallo criado en libertad en la granja' },
  { src: rebano, alt: en ? 'Flock of sheep in the barn' : 'Rebaño en el establo' },
];
---

<!-- Adelanto de la granja en la portada; la página completa vive en /granja -->
<section id="granja" class="scroll-mt-18 bg-carbon text-[#eee7df] px-4 sm:px-8 py-20 sm:py-28">
  <div class="max-w-7xl mx-auto">
    <h2 class="font-serif font-bold text-[clamp(2.25rem,5vw,4rem)] leading-[1.02] max-w-[14ch]">
      {t('farm.title')}
    </h2>

    <div class="mt-10 sm:mt-14 grid grid-cols-3 gap-2 sm:gap-6">
      {photos.map((photo) => (
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[400, 700, 1000, 1400]}
          quality={85}
          sizes="33vw"
          class="w-full aspect-3/4 object-cover"
          loading="lazy"
        />
      ))}
    </div>

    <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
      <p class="text-lg text-[#d0c6bc] max-w-[46ch]">{t('farm.teaser')}</p>
      <a
        href={routes.farm[lang]}
        class="shrink-0 self-start sm:self-auto inline-flex items-center h-13 px-7 border-2 border-[#eee7df] font-bold hover:bg-[#eee7df] hover:text-carbon transition-colors"
      >
        {t('farm.teaserCta')}
      </a>
    </div>
  </div>
</section>
