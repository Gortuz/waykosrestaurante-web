---
import { Image } from 'astro:assets';
import teamImg from '../assets/fotos/equipo.webp';
import salon from '../assets/fotos/equipo-salon.webp';
import mesera from '../assets/fotos/equipo-mesera.webp';
import plato from '../assets/fotos/equipo-plato.webp';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const en = lang === 'en';

// Misma composición que la granja: una foto ancha y tres verticales debajo
const photos = [
  { src: salon, alt: en ? 'Two team members in the wooden dining room' : 'Dos integrantes del equipo en el salón de madera' },
  { src: mesera, alt: en ? 'Server carrying two dishes by the garden' : 'Mesera llevando dos platos junto al jardín' },
  { src: plato, alt: en ? 'A dish being served with the countryside behind' : 'Un plato servido con el campo de fondo' },
];
---

<section id="equipo" class="scroll-mt-18 bg-surface px-4 sm:px-8 py-20 sm:py-28">
  <div class="max-w-7xl mx-auto">
    <h2 class="font-serif font-bold text-[clamp(2.25rem,5vw,4rem)] leading-[1.02] text-ink">
      {t('team.title')}
    </h2>
    <Image
      src={teamImg}
      alt={en ? "The kitchen and service team at Wayko's, La Esperanza, Ibarra" : "Equipo de cocina y atención de Wayko's en La Esperanza, Ibarra"}
      widths={[1024, 1600, 2400, 3200]}
      quality={85}
      sizes="(min-width: 1280px) 1216px, 100vw"
      class="mt-10 sm:mt-14 w-full aspect-4/3 sm:aspect-21/9 object-cover object-[center_40%]"
      loading="lazy"
    />
    <div class="mt-3 sm:mt-6 grid grid-cols-3 gap-2 sm:gap-6">
      {photos.map((photo) => (
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[400, 700, 1000, 1400]}
          quality={85}
          sizes="33vw"
          class="w-full aspect-3/4 object-cover"
          loading="lazy"
        />
      ))}
    </div>
  </div>
</section>
