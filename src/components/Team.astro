---
import { Image } from 'astro:assets';
import teamImg from '../assets/restaurante/equipo-waykos.webp';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const teamAlt = lang === 'en'
  ? "The kitchen and grill team at Wayko's, La Esperanza, Ibarra"
  : "Equipo de cocina y parrilla de Wayko's en La Esperanza, Ibarra";
---

<section id="equipo" class="scroll-mt-18 bg-surface py-20 sm:py-28">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-12 items-center">
    <!-- La foto llega al borde izquierdo de la pantalla -->
    <figure class="lg:col-span-7">
      <Image
        src={teamImg}
        alt={teamAlt}
        widths={[640, 1024, 1600]}
        sizes="(min-width: 1024px) 58vw, 100vw"
        class="w-full aspect-3/2 object-cover"
        loading="lazy"
      />
    </figure>

    <div class="lg:col-span-5 px-4 sm:px-8 lg:pl-0 lg:pr-[max(2rem,calc((100vw-80rem)/2+2rem))]">
      <h2 class="font-serif font-bold text-[clamp(2.25rem,5vw,4rem)] leading-[1.02] text-ink max-w-[14ch]">
        {t('team.title')}
      </h2>
      <div class="mt-6 space-y-4 text-lg text-ink-muted max-w-[46ch]">
        <p>{t('team.desc1')}</p>
        <p>{t('team.desc2')}</p>
      </div>
    </div>
  </div>
</section>
