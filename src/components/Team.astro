---
import { Image } from 'astro:assets';
import teamImg from '../assets/restaurante/equipo-waykos.webp';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="equipo" class="relative min-h-[calc(100vh-5rem)] scroll-mt-20 py-16 sm:py-20 lg:py-10 px-6 sm:px-8 flex flex-col justify-center bg-(--bg-primary) transition-colors duration-200">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Team Image Column -->
      <div class="lg:col-span-6 relative">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-(--border-subtle)">
          <Image
            src={teamImg}
            alt="Equipo de Wayko's Restaurante Rural"
            class="w-full h-auto object-cover aspect-4/3 transform hover:scale-102 transition-transform duration-500"
            loading="lazy"
          />
        </div>
        <!-- Decorative subtle accent element -->
        <div class="absolute -bottom-6 -right-6 hidden sm:flex items-center gap-3 bg-(--bg-secondary) border border-(--border-subtle) px-6 py-4 rounded-2xl shadow-xl">
          <div class="w-3 h-3 rounded-full bg-brand animate-pulse"></div>
          <span class="text-xs font-semibold tracking-wider uppercase text-(--text-title-secondary) dark:text-white">
            100% Tradición & Fuego
          </span>
        </div>
      </div>

      <!-- Narrative Column -->
      <div class="lg:col-span-6 flex flex-col justify-center">
        <p class="text-xs uppercase font-bold tracking-[0.2em] text-brand mb-3">
          {t('team.tag')}
        </p>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-(--text-title-secondary) dark:text-white tracking-tight">
          {t('team.title')}
        </h2>

        <div class="mt-6 space-y-4 text-base sm:text-lg text-(--text-muted) font-normal leading-relaxed">
          <p>{t('team.desc1')}</p>
          <p>{t('team.desc2')}</p>
        </div>

        <!-- Team Highlights -->
        <div class="mt-8 grid grid-cols-3 gap-4 pt-6 border-t border-(--border-subtle)">
          <div>
            <span class="font-serif text-2xl sm:text-3xl font-bold text-brand">10+</span>
            <p class="text-xs sm:text-sm text-(--text-muted) mt-1">Años de Sabor</p>
          </div>
          <div>
            <span class="font-serif text-2xl sm:text-3xl font-bold text-brand">100%</span>
            <p class="text-xs sm:text-sm text-(--text-muted) mt-1">Carbón & Leña</p>
          </div>
          <div>
            <span class="font-serif text-2xl sm:text-3xl font-bold text-brand">★ 4.9</span>
            <p class="text-xs sm:text-sm text-(--text-muted) mt-1">Calificación</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
