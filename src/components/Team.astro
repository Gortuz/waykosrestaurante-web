---
import { Image } from 'astro:assets';
import teamImg from '../assets/fotos/equipo.webp';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const teamAlt = lang === 'en'
  ? "The kitchen and service team at Wayko's, La Esperanza, Ibarra"
  : "Equipo de cocina y atención de Wayko's en La Esperanza, Ibarra";
---

<!-- Solo título y foto: el equipo se presenta sin texto explicativo -->
<section id="equipo" class="scroll-mt-18 bg-surface px-4 sm:px-8 py-20 sm:py-28">
  <div class="max-w-7xl mx-auto">
    <h2 class="font-serif font-bold text-[clamp(2.25rem,5vw,4rem)] leading-[1.02] text-ink">
      {t('team.title')}
    </h2>
    <Image
      src={teamImg}
      alt={teamAlt}
      widths={[800, 1200, 1800, 2400]}
      quality={85}
      sizes="(min-width: 1280px) 1216px, 100vw"
      class="mt-10 sm:mt-14 w-full aspect-4/3 sm:aspect-3/2 object-cover"
      loading="lazy"
    />
  </div>
</section>
