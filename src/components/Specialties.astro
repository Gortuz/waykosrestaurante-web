---
import { Image } from 'astro:assets';
import corderoImg from '../assets/fotos/plato-cordero.webp';
import maduroImg from '../assets/fotos/plato-maduro-queso.webp';
import lasanaImg from '../assets/fotos/plato-lasana.webp';
import pizzaImg from '../assets/fotos/plato-pizza.webp';
import { useTranslations, type Lang } from '../i18n/utils';
import { MENU_PDF_PATH } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const specialties = [
  {
    image: corderoImg,
    title: t('specialties.item1.title'),
    description: t('specialties.item1.desc'),
    price: '15.00',
    alt: lang === 'en'
      ? "Grilled lamb leg steak with potatoes and salad at Wayko's"
      : "Steak de pierna de cordero al grill con papas y ensalada en Wayko's",
  },
  {
    image: maduroImg,
    title: t('specialties.item2.title'),
    description: t('specialties.item2.desc'),
    price: '4.50',
    alt: lang === 'en'
      ? "Baked sweet plantain balls with cheese and pork crackling"
      : "Bolones de maduro con queso y chicharrón gratinados al horno",
  },
  {
    image: lasanaImg,
    title: t('specialties.item3.title'),
    description: t('specialties.item3.desc'),
    price: '7.50',
    alt: lang === 'en'
      ? "Lasagna bolognese served with potatoes and salad"
      : "Lasaña boloñesa servida con papas y ensalada",
  },
  {
    image: pizzaImg,
    title: t('specialties.item4.title'),
    description: t('specialties.item4.desc'),
    price: '7.00 / 13.00',
    alt: lang === 'en'
      ? "Artisanal pizza fresh from the oven at Wayko's"
      : "Pizza artesanal recién salida del horno en Wayko's",
  },
];

const [featured, ...others] = specialties;
---

<section id="menu" class="scroll-mt-18 bg-surface py-20 sm:py-28 px-4 sm:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-5 items-end">
      <h2 class="lg:col-span-7 font-serif font-bold text-[clamp(2.25rem,5vw,4rem)] leading-[1.02] text-ink">
        {t('specialties.title')}
      </h2>
      <p class="lg:col-span-5 text-lg text-ink-muted max-w-[44ch]">
        {t('specialties.subtitle')}
      </p>
    </div>

    <div class="mt-12 sm:mt-16 grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-10">
      <!-- Plato principal de la casa (solo escritorio; en móvil cada plato lleva su foto) -->
      <figure class="hidden lg:block lg:col-span-7">
        <Image
          src={featured.image}
          alt={featured.alt}
          widths={[640, 1024, 1600]}
          sizes="(min-width: 1024px) 55vw, 100vw"
          class="w-full aspect-4/3 object-cover"
          loading="lazy"
        />
      </figure>

      <!-- Lista con el formato de la carta impresa: nombre y precio sobre una línea roja -->
      <ul class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-12 lg:flex lg:flex-col lg:gap-0">
        {specialties.map((item) => (
          <li class="lg:py-5 lg:first:pt-0">
            <Image
              src={item.image}
              alt={item.alt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 640px) 50vw, 100vw"
              class="lg:hidden w-full aspect-4/3 object-cover mb-4"
              loading="lazy"
            />
            <div class="flex items-baseline justify-between gap-4 pb-2 border-b-2 border-rule-accent">
              <h3 class="font-serif text-xl sm:text-2xl font-semibold leading-tight text-ink">{item.title}</h3>
              <span class="font-serif text-xl sm:text-2xl font-semibold text-accent-text whitespace-nowrap tabular-nums">
                {item.price}
              </span>
            </div>
            <p class="mt-2.5 text-ink-muted leading-relaxed">{item.description}</p>
          </li>
        ))}
      </ul>
    </div>

    <!-- Fotos de los demás platos (solo escritorio) -->
    <div class="hidden lg:grid mt-12 grid-cols-3 gap-6">
      {others.map((item) => (
        <figure>
          <Image
            src={item.image}
            alt={item.alt}
            widths={[480, 800, 1200]}
            sizes="30vw"
            class="w-full aspect-square object-cover"
            loading="lazy"
          />
          <figcaption class="mt-2 text-sm text-ink-muted">{item.title}</figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-12">
      <a
        href={MENU_PDF_PATH}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center h-13 px-7 border-2 border-ink text-ink font-bold hover:bg-ink hover:text-surface transition-colors"
      >
        {t('specialties.cta')}
      </a>
    </div>
  </div>
</section>
