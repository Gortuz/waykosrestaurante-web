# ==========================================
# Variables de Entorno - Wayko's Restaurante
# ==========================================

# URL base del sitio web (para SEO y OpenGraph)
PUBLIC_SITE_URL=https://waykosrestaurante.com

# Número de teléfono para reservas por WhatsApp
# Formato internacional sin '+' ni espacios (Ecuador: 593 + número sin el 0 inicial)
PUBLIC_WHATSAPP_NUMBER=593969143757

# ID del archivo de Google Drive donde está alojada la carta oficial en PDF
# Puede ser el ID suelto (ej: 1GuA4iEbDHUJvWEOgKVh-uDRlrTWHOF3b) o el enlace completo compartido
GOOGLE_DRIVE_MENU_ID=1GuA4iEbDHUJvWEOgKVh-uDRlrTWHOF3b

